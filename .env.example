# Variables must be exported or loaded explicitly; npm start does not load .env.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
WIKI_VISIBILITY=public
WIKI_THEME=standalone
# DATA_DIR=/absolute/path/to/wiki-data

# Set all three to enable managed login for an existing User Pool.
# COGNITO_USER_POOL_ID=us-east-1_YourPool
# COGNITO_CLIENT_ID=your-app-client-id
# COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# Optional: confidential app-client secret, stored in your deployment secret manager.
# COGNITO_CLIENT_SECRET=
# Optional: members of this exact group receive wiki admin permissions.
# Without a matching admin group, all signed-in Cognito users have write access.
# COGNITO_ADMIN_GROUP=wiki-admins
